# Dados do projeto Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key

# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Usado apenas nos metadados do push (não precisa ser um email real de contato)
CONTACT_EMAIL=voce@example.com

# Nomes dos dois usuários, separados por vírgula, sem espaço
USER_NAMES=Eu,Esposa

PORT=3000
